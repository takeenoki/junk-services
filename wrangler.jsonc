{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "junk-services",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "junk-services",
			"database_id": "8546c7a5-f1bd-4878-b2d6-4310b0d2474d",
      "migrations_dir": "migrations"
		},
	]
}