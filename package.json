{
  "name": "junk-services",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:beepers": "wrangler dev --var ENABLE_POST_LIMIT:false",
    "build:beepers": "tsc -p tsconfig.beepers.json",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.beepers.json --noEmit",
    "test:api": "node --experimental-strip-types --test",
    "db:migrate:local": "wrangler d1 migrations apply junk-services --local"
},
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  }
}
